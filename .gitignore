# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Research artifacts
data/raw/*
data/processed/*
data/indices/*
outputs/*
checkpoints/
external/
wandb/
mlruns/
*.safetensors
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.parquet
*.arrow

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/indices/.gitkeep
!outputs/.gitkeep

# Local environment
.env
.env.*
!.env.example

# Local tooling
.rocketride/

# GPU-suite raw generations are bulky and re-derivable from scores
experiments/runs/*/generations/
# Contamination corpus snapshot is ~1.5 GB and re-downloadable from HF
experiments/runs/*/contamination/synthetic_corpus.jsonl

# Local Instella JUDGE manuscript bundle
/Instella_JUDGE.zip
/Instella_JUDGE/

# Credential files — HF_TOKEN lives in ~/.instella_env on the GPU box, outside any repo.
.instella_env
*.token
secrets/

# Injection-mixture filler (48 MB) and raw benchmark downloads: both re-derivable
# from experiments/build_injection_mixture.py and the HF loaders. The deletion item
# sets ARE kept — they define what the study measured.
experiments/runs/*/phase2/mixture/filler.jsonl
experiments/runs/*/base/*_all.jsonl

# Phase 3 corpus-scan results are small (~1 MB) and every claim in docs/FIGURES.md
# points at them by filename, so they are tracked rather than re-derived.
!outputs/corpus_scan/
!outputs/corpus_scan/**
.DS_Store
